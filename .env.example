# groundgate environment configuration
# Copy this file to .env and configure your keys and models.

# Provider fallback chain (comma-separated, e.g. "nvidia,openrouter" or "openrouter")
PROVIDER_ORDER="nvidia,openrouter"

# API Keys
# NVIDIA API key (from https://build.nvidia.com)
NVIDIA_API_KEY=""
# OpenRouter API key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Model IDs
# IMPORTANT: verify exact IDs from the provider's /v1/models list
# Tier 1 (fast/smaller model for initial attempt)
TIER1_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
# Tier 2 (larger model for verifier-triggered escalation)
TIER2_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# Rate limits & timeout configuration
# OpenRouter :free models allow ~20 requests/minute and 50 requests/day
REQUESTS_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=45

# Grounding gate thresholds
OVERLAP_THRESHOLD=0.60
MIN_BM25_SCORE=1.5

# Replay-only mode (set to true to test using only disk cache without network)
REPLAY_ONLY=false
